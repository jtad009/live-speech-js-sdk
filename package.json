    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.0.10",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "BSD-3-Clause"
}
