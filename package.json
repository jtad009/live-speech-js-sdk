{
  "name": "@live-speech/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Captions and transcript for a host meeting page. The Live Speech API key stays on the host server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
